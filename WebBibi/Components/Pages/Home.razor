    protected override void OnInitialized()
    {
        VeiculosFake = new List<VeiculoCardDTO>
        {
            new VeiculoCardDTO
            {
                ImagemUrl = "/Img/Img-Teste.jpg",
                Titulo = "Renault Kardian",
                Versao = "Kardian Techno (Aut)",
                Cambio = "Automático",
                Preco = "R$ 99.590,00",
                Ano = "2024/2025",
                Quilometragem = "43.264 Km",
                Localizacao = "Rio de Janeiro, RJ"
            },
            new VeiculoCardDTO
            {
                ImagemUrl = "/Img/Img-Teste.jpg",
                Titulo = "Jeep Compass",
                Versao = "Longitude T270",
                Cambio = "Automático",
                Preco = "R$ 149.900,00",
                Ano = "2023/2024",
