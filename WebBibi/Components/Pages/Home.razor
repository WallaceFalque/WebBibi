@page "/"
@using WebBibi.Models
@rendermode InteractiveServer

<PageTitle>Home</PageTitle>

<div id="heroCarousel" class="carousel slide" data-bs-ride="carousel">
    <div class="carousel-inner">
        <div class="carousel-item active">
            <img src="https://images.pexels.com/photos/3752194/pexels-photo-3752194.jpeg" class="hero-img">
            <div class="hero-overlay"></div>
            <div class="carousel-caption container">
                <h5 class="text-uppercase" style="color: var(--roxo-glow); letter-spacing: 3px;">Coleção Exclusiva</h5>
                <h1 class="display-3 fw-bold mb-4">Sinta a Experiência</h1>
                <button class="btn btn-roxo">Ver Estoque</button>
            </div>
        </div>
    </div>
</div>

<div class="container py-5">

    <div class="row align-items-center mb-5 py-5">
        <div class="col-md-6">
            <h2 class="display-5 fw-bold mb-4">Redefinindo o <span style="color: var(--roxo-glow)">Padrão.</span></h2>
            <p class="text-muted fs-5">Não entregamos apenas veículos, entregamos conquistas. Cada detalhe do nosso estoque é selecionado para quem busca perfeição.</p>
        </div>
        <div class="col-md-6">
            <img src="https://images.pexels.com/photos/1545743/pexels-photo-1545743.jpeg" class="img-fluid" style="border-left: 5px solid var(--roxo);">
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h3 class="mb-0">Destaques</h3>
            <div style="width: 50px; height: 3px; background: var(--roxo); margin-top: 10px;"></div>
        </div>
        <a href="#" class="btn-roxo-outline h10">Ver Todos</a>
    </div>

    <div class="row g-4">
        @foreach (var veiculo in VeiculosFake)
        {
            <div class="col-md-4">
                <div class="card-dark h-100">
                    <CardNovosItens Veiculo="veiculo" />
                </div>
            </div>
        }
    </div>

    <div class="my-5 p-5 text-center" style="background: linear-gradient(45deg, #1a1a1a, #000); border: 1px solid var(--roxo);">
        <h2 class="fw-bold mb-3">Simulador de Crédito</h2>
        <p class="text-muted mb-4">Taxas exclusivas para o segmento premium. Resposta em até 24h.</p>
        <a href="/simulador" class="btn btn-roxo">Simular Agora</a>
    </div>

    <div class="py-5 text-center opacity-50">
        <div class="d-flex justify-content-around flex-wrap gap-4">
            <h4 class="fw-bold">BMW</h4>
            <h4 class="fw-bold">PORSCHE</h4>
            <h4 class="fw-bold">AUDI</h4>
            <h4 class="fw-bold">MERCEDES</h4>
            <h4 class="fw-bold">LAND ROVER</h4>
        </div>
    </div>

</div>
@code {
