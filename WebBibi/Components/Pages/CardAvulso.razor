<div class="card-premium shadow-sm w-100 position-relative">

    @* Badge de Status *@
    <div class="badge-status text-white text-center p-2"
         style="background-color: var(--roxo);">
        @if (veiculo.EhOferta)
        {
            <span><i class="bi bi-lightning-fill me-1"></i> Oferta especial</span>
        }
        else
        {
            <span>Venda Especial</span>
        }
    </div>

    @* Container da Imagem *@
    <div class="img-card-container">
        <img src="@veiculo.ImagemUrl" alt="@veiculo.Modelo">
    </div>

    <div class="p-3">
        @* Título e Marca *@
        <div class="mb-3">
            <h3 class="h9 fw-bold mb-0 text-white text-uppercase">@veiculo.Modelo</h3>
            <span class="h11 text-muted">
                @veiculo.Marca • @veiculo.Ano
            </span>
        </div>

        @* Caixa de Preço e Financiamento *@
        <div class="price-box border border-secondary mb-3">
            <p class="h12 text-muted mb-1 text-uppercase">Entrada a partir de</p>
            <h2 class="h7 fw-bolder mb-0 text-roxo-light">
                @CalcularEntrada(veiculo.Preco).ToString("C")
            </h2>

            <div class="mt-2 pt-2 border-top border-secondary">
                <p class="h12 mb-0 text-muted">
                    36x de <strong class="text-white">@CalcularParcela(veiculo.Preco).ToString("C")</strong>
                </p>
                <p class="h12 mb-0 text-muted">
                    Total: <span class="text-white-50">@veiculo.Preco.ToString("C")</span>
                </p>
            </div>
        </div>

        @* Espaço Reservado para Troca (Mantém a Simetria) *@
        <div class="troca-status-container">
            @if (veiculo.AceitaUsado)
            {
                <div class="text-success-premium">
                    <i class="bi bi-check2-circle me-1"></i>
                    Aceitamos seu usado na troca
                </div>
            }
            @* Se não aceitar, a div troca-status-container continua aqui vazia, 
               segurando o espaço para os botões não subirem *@
        </div>

        @* Botões de Ação *@
        <div class="d-grid gap-2">
            <a class="btn btn-roxo-outline btn-sm py-2 fw-bold text-uppercase" style="font-size: 0.7rem;">
                Entrar em contato
            </a>

            <a class="btn btn-outline-success btn-sm py-2 fw-bold text-uppercase d-flex align-items-center justify-content-center gap-2" style="font-size: 0.7rem;">
                <i class="bi bi-whatsapp"></i> WhatsApp
            </a>
        </div>
    </div>
</div>


@code {
    [Parameter]
    public Veiculo veiculo { get; set; }  

    decimal CalcularEntrada(decimal preco)
    {
        return preco * 0.10m; 
    }

    decimal CalcularValorFinanciado(decimal preco)
    {
        return preco - CalcularEntrada(preco);
    }

    decimal CalcularParcela(decimal preco, int parcelas = 36)
    {
        return CalcularValorFinanciado(preco) / parcelas;
    }


}
