@page "/BuscaAvulso"
@rendermode InteractiveServer
@using WebBibi.Models

<div class="container-fluid search-container">
    <div class="row mx-auto justify-content-around" style="margin-top:2em; width:100%;">

        @* FILTRO *@
        <div class="col-md-3 col-lg-2 py-4">
            <div class="filter-card" style="position: sticky; top: 2rem; height: fit-content;">

                <h5 class="text-center mb-4 fw-bold text-uppercase">Filtros</h5>

                @* Tipo de Veículo - Corrigido *@
                <div class="mb-4">
                    <p class="filter-title">Veículo</p>
                    <div class="btn-toggle-group d-flex border border-secondary p-1" style="background-color: #000; overflow: hidden;">
                        <button class="btn btn-sm flex-fill rounded-0 border-0 @(ehCarro ? "btn-roxo" : "text-white")"
                                style="font-size: 0.7rem; font-weight: 700;"
                                @onclick='() => FiltroVeiculo("carro")'>
                            CARRO
                        </button>

                        <button class="btn btn-sm flex-fill rounded-0 border-0 @(ehMoto ? "btn-roxo" : "text-white")"
                                style="font-size: 0.7rem; font-weight: 700;"
                                @onclick='() => FiltroVeiculo("moto")'>
                            MOTO
                        </button>

                        <button class="btn btn-sm flex-fill rounded-0 border-0 @(ehScooter ? "btn-roxo" : "text-white")"
                                style="font-size: 0.7rem; font-weight: 700;"
                                @onclick='() => FiltroVeiculo("scooter")'>
                            SCOOTER
                        </button>
                    </div>
                </div>

                @* Localização *@
                <div class="mb-4">
                    <p class="filter-title">Localização</p>
                    <input class="form-control custom-input" type="text" placeholder="Ex: Rio de Janeiro..." value="@estadoDigitado" @oninput="AtualizarSugestoes" />

                    @if (sugestoes.Any())
                    {
                        <div class="bg-dark border border-secondary mt-1 shadow-sm position-absolute w-100" style="z-index:1000">
                            @foreach (var estado in sugestoes)
                            {
                                <div class="p-2 sugestao-item text-white border-bottom border-secondary" style="cursor:pointer" @onclick="() => SelecionarEstado(estado)">
                                    @estado
                                </div>
                            }
                        </div>
                    }
                </div>

                @* Combustível *@
                <div class="mb-4">
                    <p class="filter-title">Combustível</p>
                    <select @onchange='TipoCombustivel' class="form-select custom-input">
                        <option selected disabled>Selecione o tipo</option>
                        <option value="Gasolina">Gasolina</option>
                        <option value="Hibrido">Híbrido</option>
                        <option value="Eletrico">Elétrico</option>
                        <option value="Ambos">Ambos</option>
                    </select>
                </div>

                @* Faixa de Preço *@
                <div class="mb-4">
                    <p class="filter-title">Preço</p>
                    <div class="row g-2">
                        <div class="col-6">
                            <input class="form-control custom-input" placeholder="Min" @bind="valorMinimoInput" type="number" />
                        </div>
                        <div class="col-6">
                            <input class="form-control custom-input" placeholder="Max" @bind="valorMaximoInput" type="number" />
                        </div>
                    </div>
                    <button class="btn btn-roxo w-100 mt-2 btn-sm fw-bold" @onclick='() => IntervaloDeValor(valorMinimoInput, valorMaximoInput)'>
                        APLICAR FILTRO
                    </button>
                </div>

                @* Câmbio *@
                <div class="mb-4">
                    <p class="filter-title">Câmbio</p>
                    <div class="d-flex flex-column gap-2 px-1">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="cambio" id="auto" @onclick='() => TipoCambio("Automatico")'>
                            <label class="form-check-label text-white-50" for="auto">Automático</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="cambio" id="manual" @onclick='() => TipoCambio("Manual")'>
                            <label class="form-check-label text-white-50" for="manual">Manual</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="cambio" id="ambos" checked @onclick='() => TipoCambio("Ambos")'>
                            <label class="form-check-label text-white-50" for="ambos">Ambos</label>
                        </div>
                    </div>
                </div>

                @* Marcas *@
                <div>
                    <p class="filter-title">Marcas</p>
                    <div class="brand-grid">
                        @{
                            var marcas = new[] { "Todos", "Fiat", "Volkswagen", "Chevrolet", "Ford", "Toyota", "Hyundai", "Renault", "Nissan", "Peugeot", "Citroën", "Honda", "Jeep", "Mitsubishi", "Chery", "BYD", "GM", "Kia", "Subaru", "Suzuki", "BMW", "Volvo" };

                            foreach (var marca in marcas)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" checked="@MarcasSelecionadas.Contains(marca)" id="@marca" @onclick='() => EscolhaMarcas(marca)'>
                                    <label class="form-check-label text-white-50 h12" for="@marca">@marca</label>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>

        @* ===== GRID DE CARDS ===== *@
        <div class="col-md-9">
            <div class="row g-3">
                @foreach (var veiculo in VeiculosFake)
                {
                    @if (veiculo.TipoDeVeiculo == tipoVeiculo && !veiculo.EstadoBloqueado.Contains(estadoDigitado, StringComparer.OrdinalIgnoreCase))
                    {
                        @if (veiculo.Cambio == cambioTipo || cambioTipo == "Ambos")
                        {
                            @if ((!valorMinimo.HasValue || veiculo.Preco >= valorMinimo) && (!valorMaximo.HasValue || veiculo.Preco <= valorMaximo))
                            {
                                @if (veiculo.Combustivel == tipoCombustivel || tipoCombustivel == "Ambos")
                                {
                                    @if (MarcasSelecionadas.Contains(veiculo.Marca) || MarcasSelecionadas.Contains("Todos"))
                                    {
                                        <div class="col-sm-12 col-md-6 col-lg-3 d-flex justify-content-center">
                                            <CardAvulso Veiculo="veiculo" />
                                        </div>
                                    }
                                }
                            }
                        }
                    }
                }
            </div>
        </div>
    </div>
</div>


@code {
