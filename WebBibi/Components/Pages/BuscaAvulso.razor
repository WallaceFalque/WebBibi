    List<string> sugestoes = new();

    void AtualizarSugestoes(ChangeEventArgs e)
    {
        estadoDigitado = e.Value?.ToString() ?? "";

        if (string.IsNullOrWhiteSpace(estadoDigitado))
        {
            sugestoes.Clear();
            return;
        }

        sugestoes = estados
            .Where(e => e.Contains(estadoDigitado, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }


    void SelecionarEstado(string estado)
    {
        estadoDigitado = estado;
        sugestoes.Clear();

    }

    // Filtro de Câmbio
    void TipoCambio(string tipo)
    {
        cambioTipo = tipo;
    }

    // Filtro de preço
    void IntervaloDeValor(decimal min, decimal max)
    {
        if (max == 0)
        {
            valorMinimo = min;
            valorMaximo = 99999999999999;
            return;
        }
        valorMinimo = min;
        valorMaximo = max;
    }

    // Filtro combustivel
    void TipoCombustivel(ChangeEventArgs e)
    {
        tipoCombustivel = e.Value.ToString() ?? "Ambos";
    }

    // Filtro marcas
    List<string> MarcasSelecionadas = new()
    {
        "Todos"
    };

    void EscolhaMarcas(string marca)
    {
        if (marca != "Todos")
        {
            MarcasSelecionadas.Remove("Todos");
        }

        if (MarcasSelecionadas.Contains(marca))
        {
            MarcasSelecionadas.Remove(marca);
            return;
        }

        MarcasSelecionadas.Add(marca);

    }

