@rendermode InteractiveServer

<section class="card-veiculo-luxury shadow-lg overflow-hidden h-100">
    
    <div class="img-container">
        <img src="@Veiculo.ImagemUrl" class="ImgNovosControl" alt="@Veiculo.Titulo">
    </div>

    <div class="p-4">
        <div class="d-flex justify-content-between align-items-start mb-3">
            <div>
                <h2 class="h8 fw-bold mb-1 text-white text-uppercase">
                    @Veiculo.Titulo
                </h2>
                <span class="h11 text-muted d-block text-uppercase" style="letter-spacing: 1px;">
                    @Veiculo.Versao
                </span>
            </div>

            <a href="javascript:void(0)" @onclick="BtnClicado" class="text-decoration-none">
                @if (!isClicked)
                {
                    <i class="bi bi-heart fs-5 text-muted hover-roxo"></i>
                }        
                else
                {
                    <i class="bi bi-heart-fill fs-5" style="color: var(--roxo-glow);"></i>
                }
            </a>
        </div>

        <div class="d-flex gap-3 mb-3">
            <span class="h12 badge rounded-0 px-2 py-1" style="background: rgba(255,255,255,0.05); color: var(--text-gray);">
                <i class="bi bi-calendar3 me-1"></i> @Veiculo.Ano
            </span>
            <span class="h12 badge rounded-0 px-2 py-1" style="background: rgba(255,255,255,0.05); color: var(--text-gray);">
                <i class="bi bi-speedometer2 me-1"></i> @Veiculo.Quilometragem
            </span>
        </div>

        <div class="price-tag fw-bold mb-1">
            <span class="h11 fw-light text-muted">R$</span> @Veiculo.Preco
        </div>

        <div class="h12 text-muted mb-4">
            <i class="bi bi-geo-alt me-1"></i> @Veiculo.Localizacao
        </div>

        <div class="d-flex gap-2">
            <a class="btn btn-wpp-dark w-50 rounded-0 h11 fw-bold text-uppercase py-2">
                <i class="bi bi-whatsapp me-1"></i> Contato
            </a>

            <a class="btn btn-roxo w-50 rounded-0 h11 fw-bold text-uppercase py-2">
                Simular
            </a>
        </div>
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public VeiculoCardDTO Veiculo { get; set; } = default!;

    bool isClicked = false;

    public void BtnClicado() {
        isClicked = !isClicked;
    }
}

}